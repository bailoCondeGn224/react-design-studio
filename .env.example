# URL de base de l'API Backend
VITE_API_BASE_URL=http://localhost:3000

# Fond de carte. Vide = serveur de la fondation OpenStreetMap, dont la politique
# d'usage interdit l'exploitation commerciale à volume. Pour un déploiement qui
# monte en charge, renseigner son propre serveur ou un fournisseur sous contrat.
# Le cache du service worker suit automatiquement l'hôte configuré ici.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# Service de calcul d'itinéraire (tracé du livreur vers le client).
# Vide = serveur de démo public OSRM, réservé au développement par ses conditions
# d'usage. En production, héberger sa propre instance OSRM et la renseigner ici.
VITE_ROUTING_URL=

# Google Maps API Key — NON UTILISÉE: les cartes s'appuient sur Leaflet +
# OpenStreetMap, qui ne demandent aucune clé.
VITE_GOOGLE_MAPS_API_KEY=

# Autres configurations possibles
# VITE_APP_NAME=Élégance
# VITE_APP_VERSION=1.0.0
